    (padres ? '<span class="tag" style="background:#F4F5F7;color:#444">Hijo de: ' + padres + '</span>' : '') +
    '<h5>Se conecta así (' + frases.length + ')</h5><ul>' + frases.slice(0, 7).map(x => '<li>' + x.f + (x.card ? '<small>' + x.card + '</small>' : '') + '</li>').join('') +
    (frases.length > 7 ? '<li><small>y ' + (frases.length - 7) + ' conexiones más…</small></li>' : '') + '</ul>' +
    '<h5>Datos obligatorios</h5><ul><li>' + (campos.length ? campos.map(c => '<b>' + c.replace(/_/g, ' ') + '</b>').join(' · ') : '<small>solo el nombre</small>') + '</li></ul>' +
    '<div class="resultado" id="resultado"></div>' +
