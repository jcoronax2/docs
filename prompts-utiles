  Object.keys(POS).forEach(id => { const p = G.componentes[id].padre; if (p) add(id, p, 'jer'); });
  G.referencias.forEach(r => { if (['es_soportado_por', 'se_conecta_a', 'usa', 'es_realizada_por'].indexOf(r.tipo) >= 0) add(r.origen, r.destino, ''); });
  Object.keys(aristas).forEach(k => { s += '<path class="arista ' + aristas[k].cls + '" data-k="' + k + '" d="' + aristas[k].d + '"/>'; });
  Object.keys(POS).forEach(id => { const x = POS[id][0] - NW / 2, y = POS[id][1], n = nombre(id), c = n.length > 19 ? n.slice(0, 18) + '…' : n;
