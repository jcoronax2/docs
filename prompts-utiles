      '<text class="id" x="' + POS[id][0] + '" y="' + (y + 18) + '" text-anchor="middle">' + id + '</text><text class="nm" x="' + POS[id][0] + '" y="' + (y + 35) + '" text-anchor="middle">' + c + '</text></g>'; });
  mapa.innerHTML = s;
  $$('.nodo', mapa).forEach(g => { nodosEl[g.dataset.id] = g; g.onclick = () => clicNodo(g.dataset.id); });
  $$('.arista', mapa).forEach(p => { aristas[p.dataset.k].el = p; });
})();

let sim = null;
function reiniciarMapa() {
