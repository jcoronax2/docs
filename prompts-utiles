      declarada: declarada,
      faltan: inferida.filter(function (x) { return declarada.indexOf(x) < 0; }).sort(),
      adrs: origenes(app, 'decide_sobre', 'ADR'),
      waivers: origenes(app, 'se_otorga_a', 'Waiver')
    };
  }

