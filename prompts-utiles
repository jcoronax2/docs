    var datos = uniq(bdds.reduce(function (a, b) { return a.concat(destinos(b, 'almacena', 'EntidadDatos')); }, [])).sort();
    var nube = entornos.some(function (e) { return comp[comp[e].padre].campos.tipo_plataforma === 'nube_publica'; });
    var inferida = [];
    if (nube) inferida.push('SFC-CE-005-2019');
    if (datos.some(function (d) { return comp[d].campos.datos_personales; })) inferida.push('LEY-1581-2012');
    var declarada = comp[app].campos.regulacion || [];
    return {
      app: app,
      duenos: origenes(app, 'es_dueno_de', 'Persona'),
      capacidades: origenes(app, 'es_realizada_por', 'CapacidadNegocio'),
      entornos: entornos.map(function (e) { return { id: e, nube: comp[comp[e].padre].campos.tipo_plataforma === 'nube_publica' }; }),
