<script>
'use strict';
// Motor de la demostración: propagación de impacto y contexto de una aplicación.
// Corre igual en el navegador (se incrusta en la página) y en Node (pruebas). Sin dependencias.
(function (raiz) {
  var RANGO = { caido: 2, degradado: 1 };

  function indexar(g) {
    var sal = {}, ent = {}, hijos = {}, id;
    g.referencias.forEach(function (r) {
      (sal[r.origen] = sal[r.origen] || []).push(r);
      (ent[r.destino] = ent[r.destino] || []).push(r);
    });
    for (id in g.componentes) {
      var p = g.componentes[id].padre;
      if (p) (hijos[p] = hijos[p] || []).push(id);
    }
    return { sal: sal, ent: ent, hijos: hijos };
  }

  // Propagación por rondas síncronas: en cada ronda solo se mira el estado de la ronda anterior,
  // así cada componente sabe en qué ronda cayó (sirve para animar la "ola").
  // Devuelve { estado: {id: 'caido'|'degradado'}, ronda: {id: n}, causa: {id: {via, rel}} }.
  function impacto(g, mm, origen) {
    var ix = indexar(g);
    var prop = mm.propagacion_impacto;
    var deps = prop.dependencias.referencias;
    var atenuante = prop.dependencias.campo_atenuante;
    var realiza = prop.realizacion.referencias;
    var arrastran = prop.jerarquia.arrastran_hijos;
    var estado = {}, ronda = {}, causa = {};
    estado[origen] = 'caido'; ronda[origen] = 0; causa[origen] = { via: null, rel: 'origen' };

    for (var n = 1; n < 100; n++) {
      var prev = Object.assign({}, estado), cambios = {};
      var proponer = function (id, nuevo, via, rel) {
        if (RANGO[nuevo] <= (RANGO[prev[id]] || 0)) return;
        if (cambios[id] && RANGO[cambios[id].nuevo] >= RANGO[nuevo]) return;
        cambios[id] = { nuevo: nuevo, via: via, rel: rel };
      };
      g.referencias.forEach(function (r) {
        if (deps.indexOf(r.tipo) >= 0 && prev[r.destino]) {
          var nuevo = prev[r.destino];
          if (r.campos && r.campos[atenuante] === false) nuevo = 'degradado';
          proponer(r.origen, nuevo, r.destino, r.tipo);
        }
      });
      Object.keys(g.componentes).forEach(function (id) {
        var realizadores = (ix.sal[id] || []).filter(function (r) { return realiza.indexOf(r.tipo) >= 0; })
          .map(function (r) { return r.destino; });
        var afectados = realizadores.filter(function (x) { return prev[x]; });
        if (afectados.length) {
          var todos = afectados.length === realizadores.length && afectados.every(function (x) { return prev[x] === 'caido'; });
          proponer(id, todos ? 'caido' : 'degradado', afectados[0], 'es_realizada_por');
        }
      });
      Object.keys(ix.hijos).forEach(function (pid) {
        var hs = ix.hijos[pid];
        if (prev[pid] === 'caido' && arrastran.indexOf(g.componentes[pid].tipo) >= 0)
          hs.forEach(function (h) { proponer(h, 'caido', pid, 'hijo_de'); });
        if (prop.jerarquia.hijo_afecta_padre) {
          var af = hs.filter(function (h) { return prev[h]; });
          if (af.length) {
            var todosH = af.length === hs.length && af.every(function (h) { return prev[h] === 'caido'; });
            proponer(pid, todosH ? 'caido' : 'degradado', af[0], 'tiene_hijo');
          }
        }
      });
      var ids = Object.keys(cambios);
      if (!ids.length) break;
      ids.forEach(function (id) {
        estado[id] = cambios[id].nuevo; ronda[id] = n; causa[id] = { via: cambios[id].via, rel: cambios[id].rel };
      });
    }
    return { estado: estado, ronda: ronda, causa: causa };
  }

  function ancestro(g, id, tipo) {
    var actual = id;
    while (actual) {
      if (g.componentes[actual].tipo === tipo) return actual;
      actual = g.componentes[actual].padre;
    }
    return null;
  }

  // Hechos de una aplicación para el ARB (mismas reglas que validar.js --contexto).
  function contexto(g, app) {
    var ix = indexar(g);
    var comp = g.componentes;
    var destinos = function (id, rt, tipo) { return (ix.sal[id] || []).filter(function (r) { return r.tipo === rt && (!tipo || comp[r.destino].tipo === tipo); }).map(function (r) { return r.destino; }); };
    var origenes = function (id, rt, tipo) { return (ix.ent[id] || []).filter(function (r) { return r.tipo === rt && (!tipo || comp[r.origen].tipo === tipo); }).map(function (r) { return r.origen; }); };
    var propios = [app].concat(ix.hijos[app] || []);
    var entornos = [], bdds = [], deps = [];
    propios.forEach(function (x) {
      entornos = entornos.concat(destinos(x, 'es_soportado_por', 'Entorno'));
      bdds = bdds.concat(destinos(x, 'es_soportado_por', 'BaseDatos'));
      (ix.sal[x] || []).forEach(function (r) {
        if (r.tipo !== 'se_conecta_a') return;
        var otra = ancestro(g, r.destino, 'Aplicacion');
        if (otra && otra !== app && !deps.some(function (d) { return d.app === otra; }))
          deps.push({ app: otra, critica: !(r.campos && r.campos.critica === false) });
      });
    });
    var uniq = function (a) { return a.filter(function (x, i) { return a.indexOf(x) === i; }); };
