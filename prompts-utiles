function simular(origen) {
  reiniciarMapa();
  const res = M.impacto(G, MM, origen); sim = res;
  $$('[data-cae]').forEach(b => b.classList.toggle('on', b.dataset.cae === origen));
  const rondas = {}; Object.keys(res.estado).forEach(id => { (rondas[res.ronda[id]] = rondas[res.ronda[id]] || []).push(id); });
  const n = Math.max.apply(null, Object.keys(rondas).map(Number));
  let tot = 0, app = 0, cap = 0;
  Object.values(nodosEl).forEach(g => { if (!(g.dataset.id in res.estado)) g.classList.add('tenue'); });
  for (let r = 0; r <= n; r++) despues(r * 750, () => {
    (rondas[r] || []).forEach(id => {
      const g = nodosEl[id]; g.classList.remove('tenue'); g.classList.add(res.estado[id]); if (r === 0) g.classList.add('origen');
      const c = res.causa[id]; if (c.via) { const k = [id, c.via].sort().join('|'); if (aristas[k]) aristas[k].el.classList.add('activa'); }
