    else { const y1 = up[1] + NH, y2 = lo[1], m = (y1 + y2) / 2; d = 'M' + up[0] + ' ' + y1 + ' C' + up[0] + ' ' + m + ' ' + lo[0] + ' ' + m + ' ' + lo[0] + ' ' + y2; }
